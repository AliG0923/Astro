---
interface Props {
    url: string;
    name: string;
    isBig?: boolean;
}

const {name:PokemonName, url, isBig = false} = Astro.props;
const id = url.split('/').at(-2);
const imgSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${ id }.png`;
---
<!-- class= {`rounded  flex flex-col justify-center items-center p-2 ${!isBig && 'border'}`} > -->
 <!-- href={`/pokemons/${PokemonName}`} -->
<a

href={`/pokemon/${PokemonName}`}
class:list= {[`rounded  flex flex-col justify-center items-center p-2`,
{
    border: !isBig,
},
]} >
    <img 
    transition:name={`${PokemonName}-image`}
    class:list={[
        {
            'w-26 h-26': isBig,
            'w-22 h-22': !isBig,
        },
    ]}
    src={imgSrc} alt={PokemonName}/>
    <span class:list={
    [
        'capitalize',
        {
            'text-4xl text-blue-300' : isBig,
        },
    ]
    }>#{id} {PokemonName}</span>

</a>
