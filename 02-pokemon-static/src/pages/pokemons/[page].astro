---
import type { GetStaticPaths } from "astro";
//codigo server side only - Momento de construcción BUILD TIME

import type { PokemonListResponse } from '../../interfaces/pokemon-list.response';
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/global.css' 


export const getStaticPaths = (async({paginate}) => {
	const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151');
	const {results} = (await resp.json()) as PokemonListResponse;
	return paginate(results,{ pageSize: 20 });
}) satisfies GetStaticPaths;


const title ='Pokemon Static | Home';
const { page }  = Astro.props;

import PokemonCard from '../../components/pokemons/PokemonCard.astro';


---

<MainLayout title={title}>
	<h1 class="text-3xl">Listado Pokémons</h1>
	<hr />
<section 
	aria-label="Listado de Pokemons"
	class=" grid grid-cols-1 sm:grid-cols-3 md:grid-cols-3 gap-4 mt-5" 
		>
		{ page.data.map(({ name, url }) => (
		<PokemonCard
		name={name} 
		url={url} 
		/>
		))}
		
</section>

<section
class="flex mt-10 gap-4 items-center w-full"
>
<a  class="btn" href={page.url.prev} >Anteriores  </a>
<a  class="btn" href={page.url.next} >Siguientes </a>

<div class="flex flex-1"></div>
<span>Pagina 1</span>

</section>
</MainLayout>

<style>
	.btn {
		@reference "../../styles/global.css";
		@apply bg-blue-500 p-2 text-white rounded-md;
	}

	.disabled {
		@reference "../../styles/global.css";
		@apply bg-gray-600 text-gray-400;
	}
</style>
